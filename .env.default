# ----> DISCLAIMER <----  
# You need to duplicate this file and rename it to .env and fill in your own values for the API key and Discord webhook url.
# The program will not be able to reconize your API key or Discord webhook url if you do not do this, and will not work properly.
# So be to do it...or it doesn't work and your just wasting your time ig...other than that have fun!

CSFLOAT_API_KEY=#place your own csfloat api key here, you can get one at https://csfloat.com (you do need to spend $10 to have access to developer tools)
DISCORD_WEBHOOK_URL=#place your own discord webhook url here

MAX_BUY_PRICE_USD=5.0
MIN_BUY_PRICE_USD=0.03

# Minimum expected NET profit
MIN_PROFIT_USD=0.1
MIN_ROI_PERCENT=1.0
MIN_DISCOUNT_PERCENT=1.0
MIN_CONFIDENCE=45
MAX_ALERTS_PER_HOUR=200
SELLER_FEE_RATE=0.02 # ~cashout % fee

# Excludes
EXCLUDE_SOUVENIRS=false
EXCLUDE_STICKERED=false


# RATE LIMIT / SCANNER
POLL_SECONDS=180
AUCTIONS_ONLY=false # if true, only look at auctions
REQUEST_MIN_INTERVAL_SECONDS=6.0
REQUEST_JITTER_SECONDS=1 # random jitter to add to the request timings
RETRY_AFTER_FLOOR_SECONDS=180 # if limited waits x seconds before retrying
REQUEST_TIMEOUT_SECONDS=20 # how long to wait for a response from the CSFloat API before timing out
MAX_CANDIDATES_PER_CYCLE=20
MAX_COMPARABLE_LOOKUPS_PER_CYCLE=5
MAX_HISTORICAL_FETCHES_PER_CYCLE=18
SALES_CACHE_HOURS=12.0
HISTORY_DAYS=30 # how many days of history to fetch for historical sales

# Liquidity
MIN_RECENT_SALES=4
SALES_LOOKBACK_DAYS=10

MIN_SCAN_PRICE_CENTS=5  #keep this number at the least 5 cents since you can't buy lower than ~5-6 cents and profit
MAX_SCAN_PRICE_CENTS=0  # 0 just defaults to MAX_BUY_PRICE_USD

DATABASE_PATH=data/strikesnipe.db # preferably dont change this
USER_AGENT=StrikeSnipe/3.48 (manual-alert-only) #this is what the csfloat api sees as whats making the requests, you can change this to whatever you want, but it is recommended to keep it as is because it doesnt look sus


AUCTION_MIN_MINUTES=1
AUCTION_MAX_MINUTES=128
AUCTION_PAGES_PER_CYCLE=2
COMPARABLES_LOOKBACK_DAYS=10

#listing inclusions
INCLUDE_STICKERS=true

INCLUDE_SKINS=true

INCLUDE_CHARMS=true

INCLUDE_KEYS=true

INCLUDE_CASES=true
